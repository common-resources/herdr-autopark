#!/usr/bin/env bash
# Runs in a pane parked by autopark. Keeps the pane listed in the herdr sidebar as a
# "parked" agent (herdr only accepts agent reports from inside the pane, and refuses a custom
# report claiming "claude" in a pane the real Claude integration used; any other label works),
# waits for Enter, then hands the pane back to Claude on the same session.
# Usage: parked-wait <session-id> <cwd> <title> <parked-note> <relaunch argv...>
# AUTOPARK_PLAIN=1 shows a one-line banner instead of the transcript view.
set -u
sid=$1 cwd=$2 title=$3 note=$4
shift 4
here=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
state=${XDG_STATE_HOME:-$HOME/.local/state}/herdr-autopark
mkdir -p "$state"
src=custom:herdr-autopark
rep() { herdr pane "$@" "$HERDR_PANE_ID" --source "$src" --agent parked --seq "$(date +%s%3N)" "${extra[@]}" >/dev/null 2>>"$state/waiter.log" || echo "$(date +%T) $HERDR_PANE_ID $1 failed" >>"$state/waiter.log"; }

unregister() {
  extra=(--clear-state-labels --clear-token parked)
  rep report-metadata
  extra=()
  rep release-agent
}
leave() {
  [[ -n ${tty_saved:-} ]] && stty "$tty_saved"
  printf '\033[?1007h\033[?25h\033[?1049l'
  unregister
}
# Ctrl+C here drops back to the shell; take the sidebar entry with it.
trap leave EXIT

printf '\033]0;parked · %s\007' "$title"
extra=(--state idle --agent-session-id "$sid")
rep report-agent
label() {
  extra=(--state-label idle=parked --token "parked=$note")
  rep report-metadata
}
label

cd "$cwd" || exit 1
# Echo stays off for the whole wait (read -s only mutes while a read is pending, so wheel
# bytes landing between reads were printed), and 1007l stops wheel-to-arrow translation.
tty_saved=$(stty -g)
stty -echo -icanon
# Alternate screen + hidden cursor: a still screen with no scrollback.
printf '\033[?1049h\033[?25l\033[?1007l'
if [[ -n ${AUTOPARK_PLAIN:-} ]]; then
  draw() { printf '\033[H\033[2J\n  Parked by autopark (%s): %s\n  Press Enter to resume.\n' "$note" "$title"; }
else
  draw() { "$here/parked-view" "$sid" "$title" "$note"; }
fi
trap draw WINCH
draw
# Only Enter resumes; a wheel or arrow key sends escape bytes, which are swallowed here.
# herdr's own idle timer rewrites the idle label ("idle 42m"), so put "parked" back every minute.
while :; do
  IFS= read -rsn1 -t 60 k
  rc=$?
  if ((rc > 128)); then # timeout or WINCH
    label
    continue
  fi
  ((rc != 0)) && exit 0
  [[ -z $k ]] && break
done

trap - EXIT WINCH
leave
# The resumed agent must not inherit the view's settings (a nested parked-view would replay them).
unset AUTOPARK_SNAPSHOT AUTOPARK_KIND AUTOPARK_PLAIN
exec "$@"
