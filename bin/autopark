#!/usr/bin/env python3
"""Park idle coding agents in herdr panes to free their RAM, and leave a one-keypress resume in the pane.

Park = send /exit to the agent (it and all its MCP servers exit), then run a small bash prompt
in the same pane that waits for Enter and relaunches `<agent> <same flags> --resume <id>`.
Harness specifics (Claude Code, Hermes) live in harnesses.py.
The conversation, cwd and flags come back exactly; only the processes are gone meanwhile.

An agent is parked only when every check says it is truly idle. Any doubt means skip:
  - herdr state is idle/done (never working, blocked, unknown) and the pane is not focused
  - last real user/assistant message in the session history is older than IDLE_MINUTES. This
    survives herdr/agent restarts: a restart rewrites the transcript mtime and resets herdr's
    idle timer, but not the message timestamps.
  - nothing pending: Claude wakeups/crons/monitors/subagents, Hermes delegations/background jobs
  - the agent has no child process besides known MCP/LSP servers (a background Bash task, dev
    server, test run or shell keeps it awake)
  - the input box holds no unsent draft
  - session id / pane id is not in the config `exclude` list (config.example.toml)
Every check is repeated right before /exit to close the race with a user typing.

Usage: autopark [--daemon] [--dry-run] [--idle-minutes N] [--only PANE_ID] [--verbose]
"""

import contextlib
import datetime as dt
import glob
import json
import os
import re
import shlex
import subprocess
import sys
import time
import tomllib

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from harnesses import HARNESSES  # noqa: E402

HOME = os.path.expanduser('~')
HERE = os.path.dirname(os.path.realpath(__file__))
WAITER = f'{HERE}/parked-wait'
PLUGIN_ID = 'autopark'
# herdr hands plugins their own dirs; the fallbacks match herdr's defaults so a run from a plain
# shell (the CLI, tests) shares state and the daemon lock with the plugin-launched one.
HERDR = os.environ.get('HERDR_BIN_PATH') or 'herdr'
STATE_DIR = os.environ.get('HERDR_PLUGIN_STATE_DIR') or os.path.join(
    os.environ.get('XDG_STATE_HOME') or f'{HOME}/.local/state', 'herdr', 'plugins', PLUGIN_ID
)
DEFAULTS = {
    'idle_minutes': 60,  # park after this long without a message or subagent activity
    'interval_minutes': 10,  # how often the background loop sweeps
    'resume_grace_minutes': None,  # after a resume, stay awake this long (None = idle_minutes)
    'exclude': [],  # session ids or pane ids never to park
    'extra_benign_children': [],  # regexes for more child processes that do not count as work
    'show_transcript': True,  # parked pane shows the transcript tail (False = plain banner)
    'dry_run': False,  # log what would be parked, park nothing
    'stop_idle_subagents': True,  # answer Claude's exit dialog by stopping subagents that sat idle
}
# Children that are part of an idle session, not work in flight.
BENIGN_DEFAULT = (
    r'mcp-server|mcp_server|[-_/]mcp\b|\bmcp[-_]|/node_modules/@modelcontextprotocol/|/bin/semble\b|\buv\b.*\brun\b.*mcp'
    r'|^\S*git -c core\.fsmonitor= -c core\.hooksPath=/dev/null'
    r'|typescript-language-server|tsserver|rust-analyzer|vtsls|pyright|gopls'
)
SHELL = re.compile(r'^(\S*/)?(ba|z|fi|da)?sh\b')


def config_path():
    if os.environ.get('AUTOPARK_CONFIG'):
        return os.environ['AUTOPARK_CONFIG']
    if os.environ.get('HERDR_PLUGIN_CONFIG_DIR'):
        return os.path.join(os.environ['HERDR_PLUGIN_CONFIG_DIR'], 'config.toml')
    try:
        d = subprocess.run([HERDR, 'plugin', 'config-dir', PLUGIN_ID], capture_output=True, text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        d = ''
    return os.path.join(d or f'{HOME}/.config/herdr/plugins/config/{PLUGIN_ID}', 'config.toml')


def load_config():
    cfg = dict(DEFAULTS)
    try:
        with open(config_path(), 'rb') as f:
            user = tomllib.load(f)
    except FileNotFoundError:
        user = {}
    except (OSError, tomllib.TOMLDecodeError) as e:
        print(f'autopark: bad config, using defaults: {e}', file=sys.stderr)
        user = {}
    unknown = set(user) - set(DEFAULTS)
    if unknown:
        print(f'autopark: unknown config keys ignored: {sorted(unknown)}', file=sys.stderr)
    cfg.update({k: v for k, v in user.items() if k in DEFAULTS})
    if cfg['resume_grace_minutes'] is None:
        cfg['resume_grace_minutes'] = cfg['idle_minutes']
    return cfg


CFG = load_config()
IDLE_MINUTES = CFG['idle_minutes']
BENIGN_CHILD = re.compile('|'.join([BENIGN_DEFAULT, *CFG['extra_benign_children']]))

DRY = '--dry-run' in sys.argv  # interactive preview: print, write nothing
VERBOSE = '--verbose' in sys.argv or '--dry-run' in sys.argv
ONLY = sys.argv[sys.argv.index('--only') + 1] if '--only' in sys.argv else None
if '--idle-minutes' in sys.argv:
    IDLE_MINUTES = int(sys.argv[sys.argv.index('--idle-minutes') + 1])


def log(msg):
    line = f'{dt.datetime.now().isoformat(timespec="seconds")} {msg}'
    if VERBOSE:
        print(line)
    if not DRY:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(f'{STATE_DIR}/log', 'a') as f:
            f.write(line + '\n')


def herdr(*args):
    r = subprocess.run([HERDR, *args], capture_output=True, text=True, timeout=30)
    if r.returncode:
        raise RuntimeError(f'herdr {" ".join(args[:2])}: {r.stderr.strip()[:200]}')
    return r.stdout


def agents():
    return json.loads(herdr('agent', 'list'))['result']['agents']


def agent_pid_for(pane_id, procs):
    """Topmost process of the harness in this pane (a wrapper may re-exec or fork itself)."""
    found = {}
    for pid in filter(str.isdigit, os.listdir('/proc')):
        try:
            comm = open(f'/proc/{pid}/comm').read().strip()
            if comm not in procs and os.readlink(f'/proc/{pid}/exe').split('/')[-1] not in procs:
                continue
            env = open(f'/proc/{pid}/environ', 'rb').read().split(b'\0')
            ppid = int(open(f'/proc/{pid}/stat').read().rsplit(')', 1)[1].split()[1])
        except OSError:
            continue
        if f'HERDR_PANE_ID={pane_id}'.encode() in env:
            found[int(pid)] = ppid
    tops = [p for p, pp in found.items() if pp not in found]
    return tops[0] if len(tops) == 1 else None


def proc_start_epoch(pid):
    boot = time.time() - float(open('/proc/uptime').read().split()[0])
    ticks = int(open(f'/proc/{pid}/stat').read().rsplit(')', 1)[1].split()[19])
    return boot + ticks / os.sysconf('SC_CLK_TCK')


def busy_children(pid):
    """Descendants that are real work. Subtrees under a benign MCP/LSP server are ignored."""
    kids = {}
    for p in filter(str.isdigit, os.listdir('/proc')):
        try:
            st = open(f'/proc/{p}/stat').read().rsplit(')', 1)[1].split()
            kids.setdefault(int(st[1]), []).append((int(p), st[0]))
        except OSError:
            continue
    busy, stack = [], [pid]
    while stack:
        parent = stack.pop()
        for child, state in kids.get(parent, []):
            if state == 'Z':
                continue
            try:
                cmd = open(f'/proc/{child}/cmdline', 'rb').read().replace(b'\0', b' ').decode(errors='replace').strip()
            except OSError:
                continue
            # Only the agent's own direct children can be servers; a shell is always work in flight,
            # even when its command line happens to mention "mcp".
            if parent == pid and not SHELL.match(cmd) and BENIGN_CHILD.search(cmd):
                continue
            busy.append(cmd[:100])
            stack.append(child)
    return busy


SGR = re.compile(r'\x1b\[([0-9;]*)m')


def draft_text(pane_id):
    """Text typed after the last ❯ prompt. Placeholder hints are drawn faint (2) or italic (3)
    and are not a draft, so styled runs are dropped before looking."""
    screen = herdr('pane', 'read', pane_id, '--source', 'visible', '--format', 'ansi', '--lines', '40')
    prompt_lines = [ln for ln in screen.splitlines() if '❯' in SGR.sub('', ln)]
    if not prompt_lines:
        return '?no-input-box'
    return typed_text(prompt_lines[-1][prompt_lines[-1].index('❯') + 1 :])


def typed_text(line):
    """ANSI line after the prompt glyph, minus faint/italic placeholder runs."""
    parts = SGR.split(line)  # text, codes, text, codes, ...
    kept, hint = [parts[0]], False
    for codes, text in zip(parts[1::2], parts[2::2], strict=True):
        nums = [int(c) for c in codes.split(';') if c.isdigit()] or [0]
        i = 0
        while i < len(nums):
            n = nums[i]
            if n in (38, 48, 58):  # extended color: skip its 5;n or 2;r;g;b operands
                i += 2 if nums[i + 1 : i + 2] == [5] else 4
                continue
            if n == 0 or n in (22, 23):
                hint = False
            elif n in (2, 3):
                hint = True
            i += 1
        if not hint:
            kept.append(text)
    return ''.join(kept).strip()


def excluded():
    return {str(x) for x in CFG['exclude']}


def evaluate(a, excl):
    """Return (reason_to_skip or None, facts)."""
    pane = a['pane_id']
    if a.get('agent') == 'parked' or (a.get('state_labels') or {}).get('idle') == 'parked':
        return 'already parked', {}
    h = HARNESSES.get(a.get('agent'))
    if not h:
        return f"unsupported agent {a.get('agent')}", {}
    if a.get('agent_status') not in ('idle', 'done'):
        return f"state {a.get('agent_status')}", {}
    if a.get('focused'):
        return 'focused', {}
    pid = agent_pid_for(pane, h.procs)
    if not pid:
        return f'{h.kind} pid not found', {}
    cwd = os.readlink(f'/proc/{pid}/cwd')
    sid = h.session_id(a, pid, cwd)
    if not sid:
        return 'no session id', {}
    if sid in excl or pane in excl:
        return 'excluded', {}
    started = proc_start_epoch(pid)
    # A pane this script parked and the user then resumed gets a full idle window from the
    # resume, even if they only looked. A herdr/agent restart earns no such grace.
    rec = f'{STATE_DIR}/parked/{sid}.json'
    if os.path.exists(rec) and started > os.path.getmtime(rec) and time.time() - started < CFG['resume_grace_minutes'] * 60:
        return f'resumed from park {(time.time() - started) / 60:.0f}m ago', {}
    last_act, pending = h.activity(sid, started)
    if not last_act:
        return 'no messages', {}
    idle_min = (time.time() - last_act) / 60
    facts = {'pid': pid, 'cwd': cwd, 'idle_min': round(idle_min), 'sid': sid, 'harness': h, 'last_act': last_act}
    try:
        if float(open(f'{STATE_DIR}/parked/{sid}.abort').read()) == last_act:
            return 'last exit attempt was cancelled; waiting for new activity', facts
    except (OSError, ValueError):
        pass
    if idle_min < IDLE_MINUTES:
        return f'active {idle_min:.0f}m ago', facts
    if pending:
        return f"pending {','.join(pending)}", facts
    busy = busy_children(pid)
    if busy:
        return f'busy child: {busy[0]}', facts
    draft = draft_text(pane)
    if draft:
        return f'draft/no input box: {draft[:30]!r}', facts
    return None, facts


def idle_note(idle_min):
    h = idle_min / 60
    span = f'{h / 24:.1f}d' if h >= 48 else f'{h:.0f}h'
    return f'{span} idle, parked {dt.datetime.now():%H:%M}'


def waiter_command(kind, sid, cwd, title, note, relaunch, snapshot):
    env = [f'AUTOPARK_KIND={kind}'] + ([f'AUTOPARK_SNAPSHOT={snapshot}'] if snapshot else [])
    env += [] if CFG['show_transcript'] else ['AUTOPARK_PLAIN=1']
    return ' '.join(shlex.quote(x) for x in [*env, WAITER, sid, cwd, title, note, *relaunch])


EXIT_CONFIRM = 'Background work is running'


def exit_confirm_choice(screen):
    """Claude's exit confirmation: ('stop', items) when everything it would stop is a subagent
    and stop_idle_subagents is on, ('cancel', items) for anything else it lists, (None, [])
    when the dialog is not on screen. By now the session passed every idle check, so its
    subagents have been quiet for idle_minutes."""
    if EXIT_CONFIRM not in screen:
        return None, []
    lines = screen.splitlines()
    start = next((i for i, ln in enumerate(lines) if 'will stop when you exit' in ln), None)
    if start is None:
        return 'cancel', ['unreadable list']
    items = []
    for ln in lines[start + 1 :]:
        text = ln.strip().lstrip('❯').strip()
        if re.match(r'\d+\.', text):
            break
        if text:
            items.append(text.split('·')[0].strip())
    ok = items and all(kind == 'subagent' for kind in items) and CFG['stop_idle_subagents']
    return ('stop' if ok else 'cancel'), items


def abort(sid, facts, msg):
    """Log, and remember the activity time so the next sweeps skip this session until it moves."""
    log(msg)
    with open(f'{STATE_DIR}/parked/{sid}.abort', 'w') as f:
        f.write(str(facts['last_act']))


def park(a, facts):
    pane, pid, sid, cwd, h = a['pane_id'], facts['pid'], facts['sid'], facts['cwd'], facts['harness']
    title = a.get('terminal_title_stripped') or sid
    relaunch = h.relaunch(open(f'/proc/{pid}/cmdline', 'rb').read().decode().split('\0')[:-1], sid)
    note = idle_note(facts['idle_min'])
    if DRY or CFG['dry_run']:
        log(f'WOULD PARK {pane} {title!r} idle={facts["idle_min"]}m -> {shlex.join(relaunch)}')
        return
    os.makedirs(f'{STATE_DIR}/parked', exist_ok=True)
    # The agent's own screen, replayed while parked: exact look, no per-agent drawing code.
    snapshot = f'{STATE_DIR}/parked/{sid}.screen'
    try:
        with open(snapshot, 'w') as f:
            f.write(herdr('pane', 'read', pane, '--source', 'visible', '--format', 'ansi', '--lines', '200'))
    except (RuntimeError, OSError, subprocess.SubprocessError) as e:
        log(f'snapshot failed for {pane}, parked view will draw the history instead: {e}')
        snapshot = None
    cmd = waiter_command(h.kind, sid, cwd, title, note, relaunch, snapshot)
    # Typed rather than pasted: some harnesses (Hermes) leave a pasted line unsent.
    herdr('pane', 'send-text', pane, '/exit')
    time.sleep(0.5)
    herdr('pane', 'send-keys', pane, 'enter')
    answered = False
    for i in range(60):
        if not os.path.exists(f'/proc/{pid}'):
            break
        time.sleep(0.5)
        if answered or i < 3:
            continue
        # Claude asks before exiting while background work is open. Answer it, never leave it up.
        choice, items = exit_confirm_choice(herdr('pane', 'read', pane, '--source', 'visible', '--lines', '60'))
        if choice == 'stop':
            herdr('pane', 'send-keys', pane, 'enter')  # "1. Exit and stop tasks" is preselected
            log(f'{pane} {title!r}: stopping idle {", ".join(items)} to exit')
            answered = True
        elif choice == 'cancel':
            herdr('pane', 'send-keys', pane, 'n')
            abort(sid, facts, f'PARK ABORTED {pane} {title!r}: exit would stop {", ".join(items)}; cancelled')
            return
    else:
        abort(sid, facts, f'PARK ABORTED {pane} {title!r}: {h.kind} pid {pid} still alive 30s after /exit; left untouched')
        return
    json.dump(
        {
            'pane': pane,
            'kind': h.kind,
            'sid': sid,
            'cwd': cwd,
            'title': title,
            'relaunch': relaunch,
            'note': note,
            'idle_min': facts['idle_min'],
            'parked_at': dt.datetime.now().isoformat(timespec='seconds'),
        },
        open(f'{STATE_DIR}/parked/{sid}.json', 'w'),
        indent=2,
    )
    time.sleep(1)  # let the pane shell redraw its prompt before typing into it
    herdr('pane', 'run', pane, cmd)
    log(f'PARKED {pane} {title!r} idle={facts["idle_min"]}m sid={sid}')


def main():
    excl = excluded()
    for a in agents():
        if ONLY and a['pane_id'] != ONLY:
            continue
        reason, facts = evaluate(a, excl)
        name = a.get('terminal_title_stripped', '')[:40]
        if reason:
            if VERBOSE:
                log(f"skip {a['pane_id']} {name!r}: {reason}")
            continue
        # Re-check everything just before acting: the user may have started typing.
        fresh = next((x for x in agents() if x['pane_id'] == a['pane_id']), None)
        reason, facts = evaluate(fresh, excl) if fresh else ('vanished', {})
        if reason:
            log(f"skip {a['pane_id']} {name!r} on recheck: {reason}")
            continue
        try:
            park(fresh, facts)
        except Exception as e:  # one bad pane must not stop the sweep
            log(f"ERROR {a['pane_id']} {name!r}: {e}")


def plugin_enabled():
    """True/False from herdr, None when the server cannot be reached."""
    try:
        out = herdr('plugin', 'list', '--plugin', PLUGIN_ID, '--json')
    except (RuntimeError, OSError, subprocess.SubprocessError):
        return None
    data = json.loads(out)
    plugins = data if isinstance(data, list) else (data.get('result') or data).get('plugins', [])
    return any(p.get('plugin_id') == PLUGIN_ID and p.get('enabled') for p in plugins)


def daemon():
    """Background sweep started by the plugin's [[startup]] hook. One instance per user; it
    exits when the plugin is disabled or removed, or when the herdr server stays unreachable."""
    global CFG, IDLE_MINUTES, BENIGN_CHILD
    import fcntl

    os.makedirs(STATE_DIR, exist_ok=True)
    lock = open(f'{STATE_DIR}/daemon.lock', 'a+')  # not 'w': a losing instance must not wipe the pid
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return  # already running (server restart, live handoff)
    lock.truncate(0)
    lock.write(str(os.getpid()))
    lock.flush()
    log(f'daemon started pid={os.getpid()}')
    misses = 0
    while os.path.exists(WAITER):
        enabled = plugin_enabled()
        misses = misses + 1 if enabled is None else 0
        if enabled is False or misses >= 3:
            break
        if enabled:
            # Re-read each sweep so config edits apply without a restart.
            CFG = load_config()
            IDLE_MINUTES, BENIGN_CHILD = (
                CFG['idle_minutes'],
                re.compile('|'.join([BENIGN_DEFAULT, *CFG['extra_benign_children']])),
            )
            try:
                main()
            except Exception as e:  # keep the loop alive; the next sweep retries
                log(f'ERROR sweep: {e}')
        time.sleep(max(1, CFG['interval_minutes']) * 60)
    log('daemon stopped')


def forget_pane(pane):
    """Drop the park record, screen capture and abort marker of a closed pane. Records stay
    while the pane lives: the resume grace reads them. herdr never reuses a pane id."""
    # ponytail: a pane moved to another workspace changes id, so its files wait for a later close
    for rec in glob.glob(f'{STATE_DIR}/parked/*.json'):
        try:
            if json.load(open(rec)).get('pane') != pane:
                continue
        except (OSError, ValueError):
            continue
        for ext in ('.json', '.screen', '.abort'):
            with contextlib.suppress(FileNotFoundError):
                os.remove(rec[:-5] + ext)
        log(f'forgot {pane}: pane closed')


if __name__ == '__main__':
    if '--pane-closed' in sys.argv:  # [[events]] pane.closed
        forget_pane(json.loads(os.environ.get('HERDR_PLUGIN_EVENT_JSON') or '{}').get('data', {}).get('pane_id'))
    else:
        daemon() if '--daemon' in sys.argv else main()
