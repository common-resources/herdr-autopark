#!/usr/bin/env python3
"""Draw a still screen for a parked pane: the agent's own screen captured at park time (or,
without one, its history drawn from the session), then a fake prompt box. herdr-parked-wait calls it on the alternate screen, so
there is no scrollback to scroll into.
Usage: herdr-parked-view <session-id> <title> <parked-note>"""
import os, re, shutil, sys, textwrap

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from harnesses import HARNESSES  # noqa: E402

sid, title, note = sys.argv[1:4]
cols, rows = shutil.get_terminal_size((100, 30))
W = max(cols - 4, 20)

DIM, BOLD, RST = "\033[2m", "\033[1m", "\033[0m"
ORANGE, GREEN, GRAY_BG = "\033[38;2;215;119;87m", "\033[38;2;78;186;101m", "\033[48;2;55;55;55m"
TAG = re.compile(r"<(command-name)>(.*?)</\1>", re.S)


def wrap(text, first, rest, style=""):
    out = []
    for para in text.strip().splitlines() or [""]:
        for i, ln in enumerate(textwrap.wrap(para, W - 2) or [""]):
            out.append(f"{first if not out else rest}{style}{ln}{RST if style else ''}")
    return out


def render(block):
    kind = block[0]
    if kind == 'user':
        m = TAG.search(block[1])
        text = m.group(2).strip() if m else block[1]
        if not m and (text.lstrip().startswith('<') or text.startswith('[Request interrupted')):
            return []
        return [""] + [f"{GRAY_BG}{ln.ljust(W + 2)}{RST}" for ln in wrap(text, "❯ ", "  ")]
    if kind == 'assistant':
        return [""] + wrap(block[1], "⏺ ", "  ")
    if kind == 'tool':
        name, arg = block[1], block[2]
        return ["", f"{GREEN}⏺{RST} {BOLD}{name}{RST}" + (f"({arg[: W - len(name) - 6]})" if arg else "")]
    return [f"  {DIM}⎿  {block[1][: W - 6]}{RST}"]


SGR_ANY = re.compile(r"\x1b\[[0-9;]*m")


def crop(line, width):
    """Cut an ANSI line to `width` visible cells, keeping its escapes."""
    out, seen = [], 0
    for part in re.split(r"(\x1b\[[0-9;]*m)", line):
        if SGR_ANY.fullmatch(part):
            out.append(part)
            continue
        out.append(part[: max(width - seen, 0)])
        seen += len(part)
    return "".join(out) + RST


def snapshot_lines(path):
    """The agent's screen as it was at park time, minus its own input box (from the rule above
    the last ❯ prompt down), which the parked footer replaces."""
    snap = open(path, errors="replace").read().rstrip("\n").split("\n")
    plain = [SGR_ANY.sub("", ln) for ln in snap]
    prompts = [i for i, t in enumerate(plain) if "❯" in t]
    if prompts:
        cut = prompts[-1]
        if cut and plain[cut - 1].strip().startswith("─"):
            cut -= 1
        snap = snap[:cut]
    while snap and not SGR_ANY.sub("", snap[-1]).strip():
        snap.pop()
    return [crop(ln, cols) for ln in snap]


lines = []
snap_path = os.environ.get("AUTOPARK_SNAPSHOT")
if snap_path and os.path.exists(snap_path):
    lines = snapshot_lines(snap_path)
if not lines:
    h = HARNESSES.get(os.environ.get("AUTOPARK_KIND") or "claude")
    try:
        lines = [ln for b in h.blocks(sid) for ln in render(b)]
    except Exception as e:  # a broken history must not leave the pane blank
        lines = ["", f"{DIM}(could not read the conversation: {e}){RST}"]
if not lines:
    lines = ["", f"{DIM}(conversation not found){RST}"]

rule = f"{DIM}{'─' * cols}{RST}"
footer = [
    "",
    rule,
    f"{ORANGE}❯{RST} {BOLD}Press Enter to resume{RST}",
    rule,
    f"  {DIM}parked by autopark · {note} · {title}{RST}"[: cols + 20],
]
body = lines[-max(rows - len(footer), 0):]
# Bottom-anchor like the real UI: pad above when the transcript is short.
screen = [""] * (rows - len(footer) - len(body)) + body + footer
sys.stdout.write("\033[H\033[2J" + "\n".join(screen[:rows]))
sys.stdout.flush()
